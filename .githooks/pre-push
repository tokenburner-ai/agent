#!/bin/bash
# Tokenburner pre-push security audit.
# Blocks the push if any tracked file, any commit diff, or any commit MESSAGE
# in the push contains a forbidden pattern. Based on assistant/security-audit.md.
#
# Bypass (emergency only): git push --no-verify

set -u
REPO_ROOT="$(git rev-parse --show-toplevel)"
REPO_NAME="$(basename "$REPO_ROOT")"
RED=$'\033[31m'
YEL=$'\033[33m'
OFF=$'\033[0m'
FAIL=0

# Read stdin to discover what refs are being pushed.
RANGES=()
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue  # deleting a branch, nothing to scan
  fi
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # New branch — scan from root
    RANGES+=("$local_sha")
  else
    RANGES+=("${remote_sha}..${local_sha}")
  fi
done

scan_tracked() {
  local label="$1" pattern="$2"
  local hits
  # Exclude .githooks/ — the hook itself contains the patterns literally.
  hits="$(git grep -nE "$pattern" -- ':!.githooks/**' 2>/dev/null | head -5)"
  if [ -n "$hits" ]; then
    echo "${RED}[BLOCKED $label in tracked files]${OFF}"
    echo "$hits" | sed 's/^/  /'
    FAIL=1
  fi
}

scan_diff() {
  local label="$1" pattern="$2"
  for range in "${RANGES[@]}"; do
    local hits
    hits="$(git log -p "$range" -- . ':!.githooks/**' 2>/dev/null | grep -nE "^\+.*${pattern}" | head -5)"
    if [ -n "$hits" ]; then
      echo "${RED}[BLOCKED $label in commit diff]${OFF}"
      echo "$hits" | sed 's/^/  /'
      FAIL=1
    fi
  done
}

scan_message() {
  local label="$1" pattern="$2"
  for range in "${RANGES[@]}"; do
    # Concatenate every commit's full message (subject + body) and scan.
    local hits
    hits="$(git log "$range" --format='%H %s%n%b%n----' 2>/dev/null | grep -nE "$pattern" | head -5)"
    if [ -n "$hits" ]; then
      echo "${RED}[BLOCKED $label in commit message]${OFF}"
      echo "$hits" | sed 's/^/  /'
      FAIL=1
    fi
  done
}

echo "→ tokenburner pre-push audit on $REPO_NAME"

# ----- AWS leaks (any account, not just yours) -----
# Any 12-digit account id appearing inside an AWS ARN or "Account": "..." JSON.
scan_tracked "AWS account in ARN"  'arn:aws:[a-z0-9-]*:[a-z0-9-]*:[0-9]{12}'
scan_tracked "AWS Account JSON"    '"Account":\s*"[0-9]{12}"'
scan_diff    "AWS account in ARN"  'arn:aws:[a-z0-9-]*:[a-z0-9-]*:[0-9]{12}'
scan_diff    "AWS Account JSON"    '"Account":\s*"[0-9]{12}"'
scan_message "AWS account in ARN"  'arn:aws:[a-z0-9-]*:[a-z0-9-]*:[0-9]{12}'
scan_message "AWS Account JSON"    '"Account":\s*"[0-9]{12}"'

# AWS access-key prefixes per AWS docs:
#   AKIA — long-term IAM user keys
#   ASIA — short-term STS session keys
#   AROA — STS assumed-role principal IDs
scan_tracked "AKIA access key" 'AKIA[A-Z0-9]{16}'
scan_tracked "ASIA temp creds" 'ASIA[A-Z0-9]{16}'
scan_tracked "AROA STS role"   'AROA[A-Z0-9]{16}'
scan_diff    "AKIA access key" 'AKIA[A-Z0-9]{16}'
scan_diff    "ASIA temp creds" 'ASIA[A-Z0-9]{16}'
scan_diff    "AROA STS role"   'AROA[A-Z0-9]{16}'
scan_message "AKIA access key" 'AKIA[A-Z0-9]{16}'
scan_message "ASIA temp creds" 'ASIA[A-Z0-9]{16}'
scan_message "AROA STS role"   'AROA[A-Z0-9]{16}'

# ----- Other secrets / personal info -----
scan_tracked "sk_ api key literal" 'sk_[a-f0-9]{20,}'
scan_tracked "Private key PEM"     'BEGIN (RSA|OPENSSH|EC|DSA|PGP) PRIVATE'
scan_tracked "Personal email"      '[A-Za-z0-9._%+-]+@(yahoo|gmail|hotmail|zainar)\.com'
scan_tracked "Personal name"       '(joel\s*lach|joelllach|joellach)'

scan_diff "sk_ api key literal" 'sk_[a-f0-9]{20,}'
scan_diff "Private key PEM"     'BEGIN (RSA|OPENSSH|EC|DSA|PGP) PRIVATE'
scan_diff "Personal email"      '[A-Za-z0-9._%+-]+@(yahoo|gmail|hotmail|zainar)\.com'

scan_message "sk_ api key literal" 'sk_[a-f0-9]{20,}'
scan_message "Personal email"      '[A-Za-z0-9._%+-]+@(yahoo|gmail|hotmail|zainar)\.com'

# Co-Authored-By trailers — only as actual trailer lines, not mentions.
for range in "${RANGES[@]}"; do
  if git log "$range" --format='%b' 2>/dev/null | grep -qiE '^co-authored-by:'; then
    echo "${RED}[BLOCKED Co-Authored-By trailer in commit]${OFF}"
    echo "  Tokenburner public repos must not include Co-Authored-By trailers."
    FAIL=1
  fi
done

if [ $FAIL -eq 1 ]; then
  echo ""
  echo "${RED}Push blocked.${OFF} Fix the issues above and try again."
  echo "Emergency bypass: git push --no-verify"
  exit 1
fi

echo "${YEL}✓${OFF} audit passed"
exit 0
